{
  "name": "halyava-exe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "telegram:check": "node --env-file-if-exists=.env --import tsx src/telegram-check.ts",
    "preview:sources": "node --env-file-if-exists=.env --import tsx src/preview-sources.ts",
    "security:check": "node scripts/security-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/pipeline.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
